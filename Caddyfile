# Caddy configuration for the FHSMS frontend

{$SITE_ADDRESS::80} {
	encode zstd gzip

	# Backend API
	handle /api/* {
		reverse_proxy https://agrilinkethiopia.app.aletcloud.com
	}

	# Backend health check
	handle /health {
		reverse_proxy https://agrilinkethiopia.app.aletcloud.com
	}

	# React/Vite frontend
	handle {
		root * /srv

		# Don't cache application entry/config files
		@nocache path /index.html /sw.js /registerSW.js /config.js /manifest.webmanifest
		header @nocache Cache-Control "no-cache"

		# Cache hashed Vite assets
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"

		# React SPA fallback
		try_files {path} /index.html

		file_server
	}
}
